rget="_blank">reach out</a>!\n        </mj-text>\n        <mj-button href="https://grapesjs.com">More about GrapesJS</mj-button>\n        <mj-text align="center" padding="30px 25px 10px 25px">Happy building! \uD83D\uDE80</mj-text>\n      </mj-column>\n    </mj-section>\n  </mj-body>\n</mjml>')}]}},48454:function(e,t,n){n.d(t,{L5:function(){return d},Lg:function(){return r},qR:function(){return c}});var a=n(11252),s=n(77735);let i=a.H1,o="".concat(a.Lq,"@grapesjs/studio-sdk-plugins@").concat(i),l={category:"Extra",select:!0},d=[{id:"grapesjs-component-countdown",name:"Countdown",description:"Live countdown timer to highlight upcoming events, launches, or deadlines.",category:s.i.components,src:"".concat(a.Lq,"grapesjs-component-countdown@1.0.1/dist/index.js"),image:"https://cdn.grapesjs.com/workspaces/clywyth4s0001a5x8dfysepz7/assets/b2b347be-144d-4860-8f1a-2d8678ab07c7__plugin-counter.png",version:"1.0.1",projectType:[s.c.web],options:{props:{emptyState:!0}},instructions:'Provide data-gjs-type="countdown" on the outer wrapper and data-js attributes for inner elements:\n\n```html\n<div data-gjs-type="countdown" data-gjs-startfrom="2025-09-30" data-gjs-end-text="Expired">\n  <span data-js="countdown" class="countdown-cont">\n    <div class="countdown-block">\n      <div data-js="countdown-day" class="countdown-digit">00</div>\n      <div class="countdown-label">days</div>\n    </div>\n    <div class="countdown-block">\n      <div data-js="countdown-hour" class="countdown-digit">00</div>\n      <div class="countdown-label">hours</div>\n    </div>\n    <div class="countdown-block">\n      <div data-js="countdown-minute" class="countdown-digit">00</div>\n      <div class="countdown-label">minutes</div>\n    </div>\n    <div class="countdown-block">\n      <div data-js="countdown-second" class="countdown-digit">00</div>\n      <div class="countdown-label">seconds</div>\n    </div>\n  </span>\n  <span data-js="countdown-endtext" class="countdown-endtext"></span>\n</div>\n```\n\nThe attribute data-gjs-startfrom accepts a date format YYYY-MM-DD (not datetime).\n'},{id:"grapesjs-tabs",name:"Tabs",description:"Organize content into easy-to-navigate sections using tabs.",category:s.i.components,src:"".concat(a.Lq,"grapesjs-tabs@1.0.18/dist/index.js"),image:"https://cdn.grapesjs.com/workspaces/clywyth4s0001a5x8dfysepz7/assets/e322063c-a8b4-46d4-a21e-20f885ab53df__plugin-tabs.png",version:"1.0.18",projectType:[s.c.web],options:{tabsBlock:l},instructions:'Provide data-gjs-type to identify the components, classes and aria attributes as in the following structure:\n\n```html\n<div data-gjs-type="tabs">\n  <div data-gjs-type="tab-container" class="tab-container">\n    <div data-gjs-type="tab" id="tab1" aria-controls="tab-content-1" class="tab tab-active">\n      <span>Tab 1</span>\n    </div>\n    <div data-gjs-type="tab" id="tab2" aria-controls="tab-content-2" class="tab">\n      <span>Tab 2</span>\n    </div>\n    <div data-gjs-type="tab" id="tab3" aria-controls="tab-content-3" class="tab">\n      <span>Tab 3</span>\n    </div>\n  </div>\n  <div data-gjs-type="tab-contents" class="tab-contents">\n    <div data-gjs-type="tab-content" id="tab-content-1" aria-labelledby="tab1" class="tab-content">\n      <div>Tab Content 1</div>\n    </div>\n    <div data-gjs-type="tab-content" id="tab-content-2" aria-labelledby="tab2" class="tab-content" hidden>\n      <div>Tab Content 2</div>\n    </div>\n    <div data-gjs-type="tab-content" id="tab-content-3" aria-labelledby="tab3" class="tab-content" hidden>\n      <div>Tab Content 3</div>\n    </div>\n  </div>\n</div>\n```\n\nThe default classes provide already basic horizontal styling for the tabs and their contents but you can extend them.\nIMPORTANT: The editor allows to update active tab via this selector ".tab.tab-active", so ensure ".tab" class is always there and extend ".tab-active" styles if needed.\n'},{id:"grapesjs-custom-code",name:"Custom code",description:"Insert your own custom code directly into the page. Perfect for adding third-party widgets, advanced styling, or custom functionality.",category:s.i.components,src:"".concat(a.Lq,"grapesjs-custom-code@1.0.2/dist/index.js"),image:"https://user-images.githubusercontent.com/11614725/43289377-15322c5e-912b-11e8-9a29-cc2dc45af48a.gif",version:"1.0.2",projectType:[s.c.web]},{id:"grapesjs-tooltip",name:"Tooltip",description:"A simple, CSS-only, tooltip component. Great for adding helpful hints or extra info on hover.",src:"".concat(a.Lq,"grapesjs-tooltip@0.1.8/dist/index.js"),category:s.i.components,image:"https://cdn.grapesjs.com/workspaces/clywyth4s0001a5x8dfysepz7/assets/53239882-2c3f-4480-84cb-16fb9dd3d713__plugin-tooltip.webp",version:"0.1.8",projectType:[s.c.web],options:{propsTooltip:{emptyState:{styleOut:"width: 80px;"}}},instructions:'Provide data-gjs-type="tooltip" to identify the component, and set the tooltip text and position:\n\n```html\n<span data-gjs-type="tooltip" data-tooltip="Your tooltip text here" data-tooltip-pos="top">Hover me</span>\n```\n\nAvailable positions: top, bottom, left, right\nAVOID additional CSS, the component is fully functional with just the above HTML.\n'},{id:"grapesjs-typed",name:"Typed",description:"A typewriter-style animation component powered by Typed.js. Ideal for dynamic hero headings and attention-grabbing text effects.",category:s.i.components,src:"".concat(a.Lq,"grapesjs-typed@2.0.1/dist/index.js"),image:"https://user-images.githubusercontent.com/11614725/67621063-3f31c380-f80d-11e9-8d62-7f1da9f27111.png",version:"2.0.1",projectType:[s.c.web],options:{block:l},instructions:'Provide data-gjs-type="typed" to identify the component, and set the text strings to cycle through:\n\n```html\n<div data-gjs-type="typed" data-gjs-strings=\'["First text", "Second text", "Third text"]\' data-gjs-type-speed="40" data-gjs-start-delay="1000">Loading...</div>\n```\n\nAvailable options: data-gjs-strings (array), data-gjs-type-speed (ms), data-gjs-start-delay (ms), data-gjs-back-speed (ms), data-gjs-loop (boolean)'},{id:"StudioSdkPlugins_tableComponent",name:"Table",description:"Add table component with additional functionalities.",category:s.i.components,src:"".concat(o,"/dist/tableComponent/index.umd.js"),image:"https://app.grapesjs.com/docs-sdk/assets/images/table-plugin-f8c7596df01f9e12fb5d94a9de4ee502.png",version:i,projectType:[s.c.web],options:{block:l}},{id:"StudioSdkPlugins_listPagesComponent",name:"List Pages",description:"Add a list component that dynamically generates navigation links based on the pages in your project.",category:s.i.components,src:"".concat(o,"/dist/listPagesComponent/index.umd.js"),image:"https://app.grapesjs.com/docs-sdk/assets/images/list-pages-plugin-a315be106d0897f4167a6c93c71e7878.png",version:i,projectType:[s.c.web],options:{block:l},instructions:'Provide data-gjs-type to identify the components and use "page://PAGE_ID" format to connect to available pages:\n\n```html\n<ul data-gjs-type="list-pages">\n  <li data-gjs-type="list-pages-item">\n    <a data-gjs-type="list-pages-link" href="page://HOME_PAGE_ID">Home</a>\n  </li>\n  <li data-gjs-type="list-pages-item">\n    <a data-gjs-type="list-pages-link" href="page://ABOUT_PAGE_ID">About</a>\n  </li>\n</ul>\n```\n\nIMPORTANT: The href format must use `page://PAGE_ID` where PAGE_ID is the actual string ID of the page in the project.\nAdd list items based on your available pages and replace the href with the proper page ID.'},{id:"StudioSdkPlugins_fsLightboxComponent",name:"FsLightbox",description:"Image viewer plugin based on FsLightbox.",category:s.i.components,src:"".concat(o,"/dist/fsLightboxComponent/index.umd.js"),image:"https://app.grapesjs.com/docs-sdk/assets/images/fslightbox-plugin-5d9d81980202b475e60ccaa248036915.png",version:i,projectType:[s.c.web],options:{block:l},instructions:'Provide data-gjs-type="fslightbox" to identify the component, and place images inside:\n\n```html\n<a data-fslightbox="image-1" href="IMAGE_URL"><img src="IMAGE_PREVIEW_URL"/></a>\n<a data-fslightbox="image-2" href="IMAGE_URL"><img src="IMAGE_PREVIEW_URL"/></a>\n\n<a data-fslightbox="image-group-1" href="IMAGE_URL"><img src="IMAGE_PREVIEW_URL"/></a>\n<a data-fslightbox="image-group-1" href="IMAGE_URL"><img src="IMAGE_PREVIEW_URL"/></a>\n\n<a data-fslightbox="videos" data-gjs-source-type="video" href="YOUTUBE_VIDEO_URL"><img src="IMAGE_PREVIEW_URL"/></a>\n\n<a data-fslightbox="custom-types" href="#custom-element">Custom element</a>\n<div style="display: none">\n  <div id="custom-element">\n    <div>Custom content</div>\n  </div>\n</div>\n```'},{id:"StudioSdkPlugins_lightGalleryComponent",name:"LightGallery",description:"Gallery component based on lightGallery.",category:s.i.components,src:"".concat(o,"/dist/lightGalleryComponent/index.umd.js"),image:"https://app.grapesjs.com/docs-sdk/assets/images/lightgallery-plugin-0ef8d47f0aaa2bbdd0c83cffb9087fa4.png",version:i,projectType:[s.c.web],options:{block:l},instructions:'Use data-gjs-type="lightGallery" to create image galleries. Examples:\n\n```html\n<!-- Single image -->\n<div data-gjs-type="lightGallery">\n  <a href="IMAGE_URL">\n    <img src="IMAGE_PREVIEW_URL" alt="Image description" />\n  </a>\n</div>\n\n<!-- Multiple images in gallery -->\n<div data-gjs-type="lightGallery">\n  <a href="IMAGE1_URL">\n    <img src="IMAGE1_PREVIEW_URL" alt="Image 1" />\n  </a>\n  <a href="IMAGE2_URL">\n    <img src="IMAGE2_PREVIEW_URL" alt="Image 2" />\n  </a>\n</div>\n\n<!-- Video gallery -->\n<div data-gjs-type="lightGallery">\n  <a data-src="YOUTUBE_URL" data-poster="THUMBNAIL_URL" data-sub-html="Video Caption">\n    <img src="THUMBNAIL_URL" alt="Video thumbnail" />\n  </a>\n</div>\n\n<!-- Inline gallery -->\n<div data-gjs-type="lightGallery" data-gjs-inline="true">\n  <a href="IMAGE_URL">\n    <img src="IMAGE_PREVIEW_URL" alt="Image description" />\n  </a>\n</div>\n```'},{id:"StudioSdkPlugins_swiperComponent",name:"Swiper (Slider)",description:"Slider component plugin based on Swiper.",category:s.i.components,src:"".concat(o,"/dist/swiperComponent/index.umd.js"),image:"https://app.grapesjs.com/docs-sdk/assets/images/swiper-plugin-ded7740b473376f249829eced9003fee.png",version:i,projectType:[s.c.web],options:{block:l},instructions:'Use standard SwiperJS structure. SwiperJS options can be passed via data-gjs-{option-name} attributes:\n\n```html\n<div class="swiper" data-gjs-space-between="100" style="height: 200px">\n  <div class="swiper-wrapper">\n    <div class="swiper-slide">Slide 1</div>\n    <div class="swiper-slide">Slide 2</div>\n    <div class="swiper-slide">Slide 3</div>\n  </div>\n  <div class="swiper-button-next"></div>\n  <div class="swiper-button-prev"></div>\n  <div class="swiper-pagination"></div>\n</div>\n```\n\nSwiperJS options can be passed via data-gjs-{option-name} attributes.'},{id:"StudioSdkPlugins_iconifyComponent",name:"Iconify",description:"Add an icon component with the icon picker by levering the Iconify collections.",category:s.i.components,src:"".concat(o,"/dist/iconifyComponent/index.umd.js"),image:"https://app.grapesjs.com/docs-sdk/assets/images/iconify-plugin-265b0e0e9218b0d33744366e5a069bef.png",version:i,projectType:[s.c.web],options:{block:l}},{id:"StudioSdkPlugins_accordionComponent",name:"Accordion",description:"Accordion component, allowing users to create collapsible content sections with smooth animations and keyboard navigation support.",category:s.i.components,src:"".concat(o,"/dist/accordionComponent/index.umd.js"),image:"https://app.grapesjs.com/docs-sdk/assets/images/accordion-plugin-09ee15747de2cbc119e7e9ca654abec6.webp",version:i,projectType:[s.c.web],options:{block:l,blockGroup:l},instructions:'Provide data-gjs-type="accordion" to identify the component, and use the accordion structure:\n\n```html\n<details data-gjs-type="accordion">\n  <summary data-gjs-type="accordion-header">\n    <div>Accordion header</div>\n    <div data-gjs-type="accordion-marker"></div>\n  </summary>\n  <div data-gjs-type="accordion-content">\n    <div>Accordion content</div>\n  </div>\n</details>\n```\n\nAvailable properties: open (checkbox), clsMarkerOpen. The component uses HTML details/summary elements with custom styling and animations.'},{id:"StudioSdkPlugins_animationComponent",name:"Animations",description:"Add scroll-triggered animation components with support for staggered grouping effects.",category:s.i.components,src:"".concat(o,"/dist/animationComponent/index.umd.js"),image:"https://app.grapesjs.com/docs-sdk/assets/images/animation-plugin-f099c7cb5c88ffd5ca7794cbfcd0d7af.webp",version:i,projectType:[s.c.web],options:{block:l,blockGroup:l},instructions:'Use data-gjs-type="animation" to identify the component. Animation options are set via CSS properties in the style attribute:\n\n```html\n<!-- Basic animation -->\n<div data-gjs-type="animation" style="animation-name: fadeInUp; animation-duration: 1s">\n  Content to animate\n</div>\n\n<!-- Scroll-triggered animation -->\n<div data-gjs-type="animation" style="animation-name: slideInLeft; animation-delay: 0.5s">\n  Content that animates on scroll\n</div>\n\n<!-- Grouped animations (staggered) -->\n<div data-gjs-type="animation-group">\n  <div data-gjs-type="animation" style="animation-name: fadeInDown" class="animated-box">Item 1</div>\n  <div data-gjs-type="animation" style="animation-name: fadeInLeft" class="animated-box">Item 2</div>\n  <div data-gjs-type="animation" style="animation-name: fadeInUp" class="animated-box">Item 3</div>\n</div>\n\n<!-- Repeat animation on scroll -->\n<div data-gjs-type="animation" style="animation-name: zoomIn; --animation-repeat: true">\n  Content that repeats animation on each scroll\n</div>\n```'},{id:"StudioSdkPlugins_shapeDividerComponent",name:"Shape Divider",description:"Add shape divider components to create visually appealing section transitions.",category:s.i.components,src:"".concat(o,"/dist/shapeDividerComponent/index.umd.js"),image:"https://cdn.grapesjs.com/workspaces/clywyth4s0001a5x8dfysepz7/a